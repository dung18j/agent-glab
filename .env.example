# Credentials and identity for the git + glab + Claude Code container.
#
# Copy this file to .env, fill in the real values, and keep it out of version
# control (see .gitignore). Load it at run time with:
#
#   ./run.sh -e .env
#
# Lines starting with "#" are comments. Values must not be quoted.

# --- GitLab CLI (glab) ------------------------------------------------------

# GitLab instance. Leave as gitlab.com, or set the hostname of a self-managed
# instance (for example gitlab.example.com). A full URL is also accepted.
# The credential helper is registered for this host only, so GITLAB_TOKEN is
# never offered to other remotes.
GITLAB_HOST=gitlab.com

# Access token used by glab. Create one at
# https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: api, read_repository, write_repository.
# A project or group access token works too.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# --- git --------------------------------------------------------------------

# Identity written into commits. These are read by git from the environment.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=you@example.com

# Optional: use a specific SSH key for git over SSH instead of the agent.
# GIT_SSH_COMMAND=ssh -i /home/dev/.ssh/id_ed25519 -o IdentitiesOnly=yes

# Optional: editor used for commit messages and other interactive git steps.
# GIT_EDITOR=vim

# Optional: the image sets GIT_TERMINAL_PROMPT=0 so git fails fast instead of
# hanging when credentials are missing. Set to 1 to allow interactive prompts.
# GIT_TERMINAL_PROMPT=1

# Optional: make glab fail instead of prompting for missing input (useful when
# the agent runs unattended).
# NO_PROMPT=1

# --- Claude Code ------------------------------------------------------------

# Pick ONE way to authenticate. Leave all of them commented out to log in
# interactively with /login inside `claude`; that login is stored in the
# claude-config volume and survives container restarts.

# Claude Pro/Max subscription: run `claude setup-token` on any machine where
# you are logged in, and paste the long-lived token here.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# Anthropic Console API key (pay-as-you-go), from
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# opencode: run.sh copies the host's opencode credentials by default. Otherwise
# use `opencode auth login` in the container, or set a provider key above
# (ANTHROPIC_API_KEY) or e.g. OPENAI_API_KEY here.

# Optional: Claude Code runtime settings.
# ANTHROPIC_MODEL=claude-opus-5-5
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
